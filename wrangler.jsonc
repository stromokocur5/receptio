{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "receptio",
	"compatibility_date": "2026-09-26",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "receptio",
			"database_id": "04a31b23-68da-4df9-920d-3f32cfce06af",
			"migrations_dir": "migrations"
		}
	],
	"routes": [{ "pattern": "receptio.kohut.xyz", "custom_domain": true }],
	"observability": {
		"enabled": true
	},
	"workers_dev": true,
	"preview_urls": true
}
