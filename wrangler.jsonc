{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "receptio",
	"compatibility_date": "2026-09-26",
	"compatibility_flags": ["nodejs_als"],
	"main": "worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "receptio",
			"database_id": "04a31b23-68da-4df9-920d-3f32cfce06af",
			"migrations_dir": "migrations"
		}
	],
	// Per-IP limits (the key is the client IP). Periods can only be 10 or 60 s.
	"ratelimits": [
		{ "name": "LIKE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
		{
			"name": "NEW_DEVICE_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 3, "period": 60 }
		},
		{ "name": "SUGGEST_LIMITER", "namespace_id": "1003", "simple": { "limit": 2, "period": 60 } },
		{ "name": "SYNC_LIMITER", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } }
	],
	// Admin panel (/admin) sits behind Cloudflare Access; the Worker verifies its token too.
	"vars": {
		"ACCESS_TEAM_DOMAIN": "stromokocur5.cloudflareaccess.com",
		"ACCESS_AUD": "17c695f5c98ced0a393dc455bae2063bb73e44fb64cc9a9e00ac8256e6abf2f6",
		"ADMIN_EMAILS": "gabrielkohut3@gmail.com,gabrielkohut3@proton.me",
		// Frontend hostnames Turnstile tokens may come from (secret TURNSTILE_SECRET is set on the Worker).
		"TURNSTILE_HOSTNAMES": "receptio.kohut.xyz,receptio.gabrielkohut3.workers.dev"
	},
	// Water reminders: every quarter hour, see src/lib/server/push.ts (secret VAPID_PRIVATE_JWK).
	"triggers": { "crons": ["*/15 * * * *"] },
	"routes": [{ "pattern": "receptio.kohut.xyz", "custom_domain": true }],
	"observability": {
		"enabled": true
	},
	"workers_dev": true,
	"preview_urls": true
}
